# =========================================================
# CPCN Connect — Variables d'Environnement
# =========================================================

# URL du backend / API distante (optionnelle en mode démonstration locale autonome)
# Laisser vide pour utiliser le mock et la persistance LocalStorage intégrée.
# Exemple en production : https://api.cpcn-ngangue.org
VITE_API_URL=

# Nom et titre officiel de l'assemblée
VITE_CHURCH_NAME="Communauté de la Bannière Frontière Globale — CPCN Connect"

# Environnement d'exécution (development | production)
VITE_APP_ENV="development"

# Clé API Google Gemini (uniquement si vous activez les fonctionnalités d'assistance pastorale IA côté serveur)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL publique de l'application
APP_URL="MY_APP_URL"
